{
  "name": "pinecall",
  "version": "0.9.29",
  "description": "The pinecall CLI: an agent's project in any language — prompt, chat, test, simulate, start, deploy — against the Pinecall gateway",
  "license": "Apache-2.0",
  "author": "Pinecall <hello@pinecall.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinecall/cli.git"
  },
  "type": "module",
  "bin": {
    "pinecall": "./bin/pinecall.js"
  },
  "files": [
    "dist",
    "templates"
  ],
