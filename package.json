    "lint": "tsc -p tsconfig.lint.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pinecall/agents": "^0.9.20",
    "ignore": "^7.0.12",
    "tsx": "^4.20.6",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@livekit/rtc-node": "^0.13.35"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "bin": {
      "pinecall": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
